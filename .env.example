FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=8000
SECRET_KEY=dev-secret-key

# --- Postgres (pick one setup) ---

# Local Docker (`docker compose --profile local-db up`): host must be `postgres`
POSTGRES_USER=rajniti
POSTGRES_PASSWORD=rajniti
POSTGRES_DB=rajniti
DATABASE_URL=postgresql://rajniti:rajniti@postgres:5432/rajniti

# From your Mac to that same container (port published):
# DATABASE_URL=postgresql://rajniti:rajniti@127.0.0.1:5432/rajniti

# Supabase (encode @ in password as %40):
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require

DB_ECHO=true

# Optional: disable forcing IPv4 for Postgres hostnames
# DATABASE_SKIP_IPV4_FORCE=1

# Skip automatic CREATE TABLE on startup (if you manage schema only via Alembic/SQL)
# SKIP_DB_AUTO_CREATE=1

GROQ_API_KEY=
