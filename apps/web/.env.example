# ─── @rajniti/web environment ──────────────────────────────────────────────
# Copy to .env.local and fill in. NEVER commit real values.
#   cp .env.example .env.local

# Backend API (Flask). In dev the API runs on :8000 via `pnpm dev`.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# SSR / server-side rewrites target (server-only, not exposed to the browser).
API_REWRITE_TARGET=http://localhost:8000

# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Auth (NextAuth) ─────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me

# ── Supabase (single project — see repo README) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
