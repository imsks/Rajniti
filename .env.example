# ─── Rajniti Environment Variables ────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Flask ──────────────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=8000
SECRET_KEY=change-me-in-production

# ── Database ───────────────────────────────────────────────────────────────────
# For Docker (make dev / make dev-api): container hostname "postgres"
DATABASE_URL=postgresql://rajniti:rajniti@postgres:5432/rajniti

# For local venv against Docker Postgres (published port on host):
# DATABASE_URL=postgresql://rajniti:rajniti@localhost:5432/rajniti

# For Supabase (make prod): use session-mode pooler (port 5432)
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Docker Postgres container settings (only used by docker-compose local-db profile)

DB_ECHO=false

# Optional overrides:
# SKIP_DB_AUTO_MIGRATE=1       # Skip Alembic auto-migration on startup
# SKIP_DB_AUTO_CREATE=1        # Skip CREATE TABLE on startup

# ── LLM Providers (at least one required for agents) ──────────────────────────
# Comma-separated priority list
AGENT_LLM_PROVIDERS=gemini,perplexity,openai

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

PERPLEXITY_API_KEY=
AGENT_PERPLEXITY_MODEL=sonar

OPENAI_API_KEY=
AGENT_OPENAI_MODEL=gpt-4o-mini

# ── Telemetry ─────────────────────────────────────────────────────────────────
ANONYMIZED_TELEMETRY=False
