FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=8000
SECRET_KEY=dev-secret-key

# --- Postgres: choose ONE flow (local compose OR Supabase). Same DATABASE_URL rules for both. ---

# == Local Docker Postgres (profile local-db) ==
# Host must be `postgres` when the API runs inside compose; user/password/db must match.
POSTGRES_USER=rajniti
POSTGRES_PASSWORD=rajniti
POSTGRES_DB=rajniti
DATABASE_URL=postgresql://rajniti:rajniti@postgres:5432/rajniti

# Run API on your machine while Postgres is in Docker (published port):
# DATABASE_URL=postgresql://rajniti:rajniti@127.0.0.1:5432/rajniti

# == Supabase only (no local Postgres container) ==
# Use the direct connection string (host db.<project>.supabase.co, port 5432), NOT the pooler (6543).
# Encode @ in the password as %40. Example:
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require

DB_ECHO=false

# Optional: disable IPv4 hostaddr forcing if your network needs IPv6-only
# DATABASE_SKIP_IPV4_FORCE=1

# Skip automatic CREATE TABLE on startup (manage schema only via Alembic/SQL)
# SKIP_DB_AUTO_CREATE=1

GROQ_API_KEY=
