# Flask Application Configuration
FLASK_ENV=development
FLASK_HOST=0.0.0.0
FLASK_PORT=8000
FLASK_DEBUG=True

# Security
SECRET_KEY=dev-secret-key-change-in-production

# Database Configuration - ONLY THIS IS NEEDED!
# Works with Supabase or local PostgreSQL - just change the URL
# 
# Option 1: Supabase (default)
DATABASE_URL=postgresql://user:password@host:port/database
#
# Option 2: Local PostgreSQL (start with: docker-compose --profile local-db up)
# DATABASE_URL=postgresql://rajniti:rajniti_dev_password@postgres:5432/rajniti

# Database logging (set to true to see SQL queries in logs)
DB_ECHO=false

# ChromaDB Configuration
CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION_NAME=rajniti_embeddings

# API Configuration
API_VERSION=v1
API_PREFIX=/api/v1

# Perplexity AI API Configuration
LLM_PROVIDER=perplexity
OPENAI_API_KEY=
OPENAI_MODEL=
PERPLEXITY_API_KEY=
PERPLEXITY_MODE=
