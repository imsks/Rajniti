# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_secreat_key

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Backend API URL (browser / client components)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Server-side API URL (production only — when NEXT_PUBLIC_API_URL is not localhost).
# Local/Docker SSR uses the Next.js /api/v1 rewrite (set API_REWRITE_TARGET in Docker).
# API_URL=http://internal-api:8000/api/v1
# API_REWRITE_TARGET=http://127.0.0.1:8000

# Canonical site URL (SEO: Open Graph, sitemap, canonical links). Defaults to NEXTAUTH_URL or localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 — leave empty to disable tracking
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# On-demand ISR revalidation for politician profiles (POST /api/revalidate/politician)
REVALIDATION_SECRET=
# POLITICIAN_REVALIDATE_SECONDS=3600
#Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
