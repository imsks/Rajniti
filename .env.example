# ─── Rajniti Environment Variables ────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Flask ──────────────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=8000
SECRET_KEY=change-me-in-production

# ── Database ───────────────────────────────────────────────────────────────────
# For Docker (make dev / make dev-api): container hostname "postgres"
DATABASE_URL=postgresql://rajniti:rajniti@postgres:5432/rajniti

# For local venv against Docker Postgres (published port on host):
# DATABASE_URL=postgresql://rajniti:rajniti@localhost:5432/rajniti

# For Supabase (make prod): use session-mode pooler (port 5432)
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

DB_ECHO=false

# Optional overrides:
# SKIP_DB_AUTO_MIGRATE=1       # Skip Alembic auto-migration on startup
# SKIP_DB_AUTO_CREATE=1        # Skip CREATE TABLE on startup

# ── LLM mode (single switch for agents + browser-use) ─────────────────────────
# true  = LM Studio at LMSTUDIO_BASE_URL (local model, no API key needed)
# false = cloud providers from AGENT_LLM_PROVIDERS (requires API keys)
USE_LOCAL_LLM=false

# Local LLM (when USE_LOCAL_LLM=true)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_MODEL=google/gemma-4-26b-a4b-qat

# Cloud LLM (when USE_LOCAL_LLM=false) — edit DEFAULT_PROVIDERS in app/config/free_tier_llm.py
# or set API keys below (FreeTierLLM rotates through providers that have keys)

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

PERPLEXITY_API_KEY=
AGENT_PERPLEXITY_MODEL=sonar

OPENAI_API_KEY=
AGENT_OPENAI_MODEL=gpt-4o-mini

# Browser-use — generic scrape vs structured MyNeta extract
# Generic POST /api/v1/scrape defaults AGENT_FLASH_MODE=true (fast local models)
# Structured affidavit extract always navigates (flash_mode=false in code)
# AGENT_FLASH_MODE=true
# AGENT_USE_VISION=false
# AGENT_MAX_STEPS=25
# AGENT_MIN_STEPS=2
# AGENT_LLM_TIMEOUT=300
# AGENT_STEP_TIMEOUT=300

# ── Telemetry ─────────────────────────────────────────────────────────────────
ANONYMIZED_TELEMETRY=False
