# Flask Application Configuration
FLASK_ENV=development
FLASK_HOST=0.0.0.0
FLASK_PORT=8000
FLASK_DEBUG=True

# Security
SECRET_KEY=dev-secret-key-change-in-production

# Database Configuration - ONLY THIS IS NEEDED!
# Works with Supabase or local PostgreSQL - just change the URL
# 
# Option 1: Supabase (default)
DATABASE_URL=postgresql://user:password@host:port/database
#
# Option 2: Local PostgreSQL (start with: docker-compose --profile local-db up)
# DATABASE_URL=postgresql://rajniti:rajniti_dev_password@postgres:5432/rajniti

# Database logging (set to true to see SQL queries in logs)
DB_ECHO=false

# ChromaDB Configuration
CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION_NAME=rajniti_embeddings
# LLM Provider Configuration
# Default provider to use (openai or perplexity)
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_TEMPERATURE=0.3
# OPENAI_MAX_TOKENS=1000  # Optional

# Perplexity Configuration
PERPLEXITY_API_KEY=your-perplexity-api-key-here
PERPLEXITY_MODEL=sonar
PERPLEXITY_TEMPERATURE=0.3
# PERPLEXITY_MAX_TOKENS=1000  # Optional

# API Configuration
API_VERSION=v1
API_PREFIX=/api/v1

# Perplexity AI API Configuration
LLM_PROVIDER=perplexity
OPENAI_API_KEY=
OPENAI_MODEL=
PERPLEXITY_API_KEY=
PERPLEXITY_MODE=
