{
  "name": "rajniti",
  "version": "0.1.0",
  "private": true,
  "description": "Rajniti monorepo — civic tech for political accountability in India.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "docker compose up -d chroma && turbo run dev",
    "dev:web": "turbo run dev --filter=@rajniti/web",
    "dev:api": "turbo run dev --filter=@rajniti/api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3"
  }
}
