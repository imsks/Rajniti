# ─── @rajniti/api environment ──────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit real values.
#   cp .env.example .env
# In production these are provided by GCP Secret Manager (see repo README).

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=8000
SECRET_KEY=change-me-in-production

# ── Database (single Supabase project — see repo README) ────────────────────
# Local Postgres (docker compose --profile local-db):
DATABASE_URL=postgresql://rajniti:rajniti@localhost:5432/rajniti
# Supabase session pooler (prod):
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Vector store (ChromaDB) ─────────────────────────────────────────────────
# Dev: local container (docker compose up -d chroma).
CHROMA_HOST=localhost
CHROMA_PORT=8001
# Prod: embedded persistent index baked into the image at this path.
CHROMA_INDEX_PATH=/app/index

# ── LLM providers (at least one required for agents) ────────────────────────
AGENT_LLM_PROVIDERS=gemini,perplexity,openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PERPLEXITY_API_KEY=
OPENAI_API_KEY=

# ── Telemetry ─────────────────────────────────────────────────────────────────
ANONYMIZED_TELEMETRY=False
