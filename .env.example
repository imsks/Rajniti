FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=8000
SECRET_KEY=dev-secret-key

# ── Database: choose ONE option ─────────────────────────────────────────────

# == Option A: Local Docker Postgres (profile local-db) ==
# Use host `postgres` when the API runs inside Docker Compose.
POSTGRES_USER=rajniti
POSTGRES_PASSWORD=rajniti
POSTGRES_DB=rajniti
DATABASE_URL=postgresql://rajniti:rajniti@postgres:5432/rajniti
# From venv on your Mac (not Docker), use localhost instead:
# DATABASE_URL=postgresql://rajniti:rajniti@127.0.0.1:5432/rajniti

# == Option B: Supabase ==
# IMPORTANT: Use the SESSION-MODE POOLER URL (pooler.supabase.com, port 5432).
# The direct URL (db.xxx.supabase.co) is IPv6-only and FAILS in Docker.
# Encode @ in the password as %40. Example:
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
#
# DO NOT use the transaction pooler (port 6543) — it breaks DDL (CREATE TABLE).

DB_ECHO=false

# Optional overrides:
# DATABASE_SKIP_IPV4_FORCE=1    # Disable automatic IPv4 hostaddr forcing
# DATABASE_HOSTADDR=1.2.3.4    # Manual IPv4 override for the DB host
# SKIP_DB_AUTO_CREATE=1        # Skip CREATE TABLE on startup (use Alembic instead)

GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
